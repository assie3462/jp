            <style>
                .assie-sitemaps {
                    --as-green: #7CFF00;
                    --as-cyan: #55DFFF;
                    --as-white: #FFFFFF;
                    --as-muted: #C6D2D2;
                    --as-border: rgba(124, 255, 0, 0.35);
                    box-sizing: border-box;
                    width: 100%;
                    padding: 48px 20px 64px;
                    background: #000000;
                    color: var(--as-white);
                    font-family: "Noto Sans JP",
                        "Hiragino Kaku Gothic ProN",
                        sans-serif;
                    line-height: 1.8;
                    overflow-wrap: anywhere;
                }

                .assie-sitemaps *,
                .assie-sitemaps *::before,
                .assie-sitemaps *::after {
                    box-sizing: border-box;
                }

                .assie-sitemaps .as-inner {
                    width: 100%;
                    max-width: 1000px;
                    margin: 0 auto;
                }

                .assie-sitemaps .as-header {
                    padding: 0 0 28px;
                    border-bottom: 1px solid var(--as-border);
                    text-align: center;
                }

                .assie-sitemaps .as-header h1 {
                    margin: 0 0 16px;
                    color: var(--as-green);
                    font-size: clamp(26px, 5vw, 42px);
                    line-height: 1.5;
                    overflow-wrap: anywhere;
                }

                .assie-sitemaps .as-header p {
                    max-width: 760px;
                    margin: 0 auto;
                    color: var(--as-muted);
                    font-size: 15px;
                    text-align: left;
                }

                .assie-sitemaps .as-group {
                    margin: 32px 0 0;
                    padding: 24px;
                    border: 1px solid var(--as-border);
                    border-radius: 14px;
                    background: #080B0A;
                }

                .assie-sitemaps .as-group h2 {
                    margin: 0 0 16px;
                    padding: 0 0 10px;
                    border-bottom: 1px solid var(--as-border);
                    color: var(--as-green);
                    font-size: 21px;
                    line-height: 1.6;
                }

                .assie-sitemaps .as-group ul {
                    margin: 0;
                    padding-left: 1.4em;
                    list-style: disc;
                }

                .assie-sitemaps .as-group li {
                    margin: 8px 0;
                    padding-left: 3px;
                    color: var(--as-muted);
                }

                .assie-sitemaps .as-group a {
                    color: var(--as-cyan);
                    text-decoration: underline;
                    text-decoration-thickness: 1px;
                    text-underline-offset: 4px;
                    overflow-wrap: anywhere;
                }

                .assie-sitemaps .as-group a:hover {
                    color: var(--as-green);
                }

                .assie-sitemaps .as-group a:focus-visible {
                    outline: 2px solid var(--as-green);
                    outline-offset: 4px;
                    border-radius: 2px;
                }

                .assie-sitemaps .as-description {
                    display: block;
                    margin-top: 3px;
                    color: var(--as-muted);
                    font-size: 13px;
                }

                .assie-sitemaps .as-footer {
                    margin-top: 36px;
                    padding-top: 20px;
                    border-top: 1px solid var(--as-border);
                    color: var(--as-muted);
                    font-size: 13px;
                    text-align: center;
                }

                .assie-sitemaps .as-footer a {
                    color: var(--as-cyan);
                }

                @media (max-width: 600px) {
                    .assie-sitemaps {
                        padding: 32px 14px 44px;
                    }

                    .assie-sitemaps .as-group {
                        margin-top: 20px;
                        padding: 18px 16px;
                    }

                    .assie-sitemaps .as-group h2 {
                        font-size: 18px;
                    }


                    .assie-sitemaps .as-header p {
                        font-size: 14px;
                    }
                }
@media (max-width: 767px) {
.assie-sitemaps .as-inner &gt; a[href="/"] {
display: block;
margin: 16px 0;
text-align: center;
}
.assie-sitemaps .as-inner &gt; a[href="/"] img {
display: block;
max-width: 100%;
height: auto;
margin: 0 auto 8px;
}
.assie-sitemaps img[src*="apf.png"] {
display: block;
max-width: 100%;
height: auto;
margin: 0 auto 8px;
}
}
</style>

